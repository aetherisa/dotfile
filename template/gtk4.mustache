/* Base16 {{scheme-name}}
 * Author: {{scheme-author}}
 *
 * GTK 4 and libadwaita semantic colors. Current libadwaita reads the CSS
 * custom properties; the named colors below cover GTK 4 and compatibility
 * paths that still use the pre-custom-property color API.
 */

:root {
  --window-bg-color: #{{base00-hex}};
  --window-fg-color: #{{base05-hex}};
  --view-bg-color: #{{base00-hex}};
  --view-fg-color: #{{base05-hex}};

  --headerbar-bg-color: #{{base01-hex}};
  --headerbar-fg-color: #{{base05-hex}};
  --headerbar-border-color: #{{base02-hex}};
  --headerbar-backdrop-color: #{{base00-hex}};
  --headerbar-shade-color: alpha(#{{base00-hex}}, 0.36);
  --headerbar-darker-shade-color: alpha(#{{base00-hex}}, 0.90);

  --sidebar-bg-color: #{{base01-hex}};
  --sidebar-fg-color: #{{base05-hex}};
  --sidebar-backdrop-color: #{{base00-hex}};
  --sidebar-border-color: #{{base02-hex}};
  --secondary-sidebar-bg-color: #{{base00-hex}};
  --secondary-sidebar-fg-color: #{{base05-hex}};
  --secondary-sidebar-backdrop-color: #{{base00-hex}};
  --secondary-sidebar-border-color: #{{base02-hex}};

  --card-bg-color: #{{base01-hex}};
  --card-fg-color: #{{base05-hex}};
  --dialog-bg-color: #{{base01-hex}};
  --dialog-fg-color: #{{base05-hex}};
  --popover-bg-color: #{{base01-hex}};
  --popover-fg-color: #{{base05-hex}};
  --popover-shade-color: alpha(#{{base00-hex}}, 0.25);

  --accent-color: #{{base0D-hex}};
  --accent-bg-color: #{{base0D-hex}};
  --accent-fg-color: #{{base00-hex}};
  --destructive-color: #{{base08-hex}};
  --destructive-bg-color: #{{base08-hex}};
  --destructive-fg-color: #{{base00-hex}};
  --error-color: #{{base08-hex}};
  --error-bg-color: #{{base08-hex}};
  --error-fg-color: #{{base00-hex}};
  --warning-color: #{{base0A-hex}};
  --warning-bg-color: #{{base0A-hex}};
  --warning-fg-color: #{{base00-hex}};
  --success-color: #{{base0B-hex}};
  --success-bg-color: #{{base0B-hex}};
  --success-fg-color: #{{base00-hex}};

  --shade-color: alpha(#{{base00-hex}}, 0.25);
  --scrollbar-outline-color: #{{base02-hex}};
}

@define-color window_bg_color #{{base00-hex}};
@define-color window_fg_color #{{base05-hex}};
@define-color view_bg_color #{{base00-hex}};
@define-color view_fg_color #{{base05-hex}};
@define-color headerbar_bg_color #{{base01-hex}};
@define-color headerbar_fg_color #{{base05-hex}};
@define-color headerbar_border_color #{{base02-hex}};
@define-color headerbar_backdrop_color #{{base00-hex}};
@define-color sidebar_bg_color #{{base01-hex}};
@define-color sidebar_fg_color #{{base05-hex}};
@define-color secondary_sidebar_bg_color #{{base00-hex}};
@define-color secondary_sidebar_fg_color #{{base05-hex}};
@define-color card_bg_color #{{base01-hex}};
@define-color card_fg_color #{{base05-hex}};
@define-color dialog_bg_color #{{base01-hex}};
@define-color dialog_fg_color #{{base05-hex}};
@define-color popover_bg_color #{{base01-hex}};
@define-color popover_fg_color #{{base05-hex}};
@define-color accent_color #{{base0D-hex}};
@define-color accent_bg_color #{{base0D-hex}};
@define-color accent_fg_color #{{base00-hex}};
@define-color destructive_color #{{base08-hex}};
@define-color destructive_bg_color #{{base08-hex}};
@define-color destructive_fg_color #{{base00-hex}};
@define-color error_color #{{base08-hex}};
@define-color error_bg_color #{{base08-hex}};
@define-color error_fg_color #{{base00-hex}};
@define-color warning_color #{{base0A-hex}};
@define-color warning_bg_color #{{base0A-hex}};
@define-color warning_fg_color #{{base00-hex}};
@define-color success_color #{{base0B-hex}};
@define-color success_bg_color #{{base0B-hex}};
@define-color success_fg_color #{{base00-hex}};

/* Compatibility aliases expected by plain GTK applications. */
@define-color theme_bg_color #{{base00-hex}};
@define-color theme_fg_color #{{base05-hex}};
@define-color theme_base_color #{{base00-hex}};
@define-color theme_text_color #{{base05-hex}};
@define-color theme_selected_bg_color #{{base0D-hex}};
@define-color theme_selected_fg_color #{{base00-hex}};
@define-color insensitive_bg_color #{{base01-hex}};
@define-color insensitive_fg_color #{{base03-hex}};
@define-color insensitive_base_color #{{base01-hex}};
@define-color borders #{{base02-hex}};
@define-color unfocused_borders #{{base01-hex}};
@define-color theme_unfocused_bg_color #{{base00-hex}};
@define-color theme_unfocused_fg_color #{{base04-hex}};
@define-color theme_unfocused_base_color #{{base00-hex}};
@define-color theme_unfocused_text_color #{{base04-hex}};
@define-color theme_unfocused_selected_bg_color #{{base02-hex}};
@define-color theme_unfocused_selected_fg_color #{{base05-hex}};
